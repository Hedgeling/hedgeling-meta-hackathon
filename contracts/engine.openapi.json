{
  "openapi": "3.1.0",
  "info": {
    "title": "Private Hedgeling Engine API",
    "version": "1.0.0",
    "description": "Server-to-server API. Existing proprietary engine remains private. GitHub connections are operator-provisioned. See README for authorization, limits, retention and setup."
  },
  "security": [
    {
      "serverToken": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Database reachable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId": "capabilities",
        "description": "Requires engine:read.",
        "responses": {
          "200": {
            "description": "Enabled operations and caps",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/connections": {
      "get": {
        "operationId": "listConnections",
        "description": "Requires engine:read. Results are restricted to the credential's tenant and connection list.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Repository page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "connections": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "owner",
                          "repository"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "owner": {
                            "type": "string"
                          },
                          "repository": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "nextOffset": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/jobs": {
      "post": {
        "operationId": "createJob",
        "description": "Requires engine:run. A new job creates a private processing record; it does not write to GitHub. Same key/request replays the original job for seven days. New runs need new keys.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{8,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateJob"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Processing job",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "$ref": "#/components/schemas/Job"
                    },
                    "replayed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Processing job",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "$ref": "#/components/schemas/Job"
                    },
                    "replayed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Relative job status URL",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/jobs/{id}": {
      "get": {
        "operationId": "getJob",
        "description": "Requires engine:read. Foreign-tenant or unbound repository IDs return 404.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Processing job",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "$ref": "#/components/schemas/Job"
                    },
                    "replayed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/jobs/{id}/artifact": {
      "get": {
        "operationId": "getArtifact",
        "description": "Requires engine:read. Available only after success, until expiry. JSON download; no public artifact URLs.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Versioned extraction artifact",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Artifact"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/jobs/{id}/cancel": {
      "post": {
        "operationId": "cancelJob",
        "description": "Requires engine:cancel. Stops queued/running work. Terminal states remain unchanged. No artifact is published after cancellation.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Processing job",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "$ref": "#/components/schemas/Job"
                    },
                    "replayed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/connections/{id}/config": {
      "get": {
        "operationId": "readExtractionConfig",
        "description": "Requires engine:read and an allowed connection. Reads only an ordinary UTF-8 JSON file of at most 32 KiB, pinned to a commit. Returns supported settings plus omitted field names, never provider configuration or secrets. Does not execute repository code.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ref",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 512
            },
            "description": "Literal repository-relative path ending in .hedgeling/extract.config.json; no traversal or symlinks."
          }
        ],
        "responses": {
          "200": {
            "description": "Pinned config, or found=false with empty settings when missing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "repositoryId": {
                      "type": "integer"
                    },
                    "commitSha": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "found": {
                      "type": "boolean"
                    },
                    "settings": {
                      "$ref": "#/components/schemas/ExtractionSettings"
                    },
                    "ignoredFields": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/jobs/{jobId}/model-requests": {
      "get": {
        "operationId": "pendingModelRequests",
        "description": "Requires engine:read. Only a running tune-llm job returns requests. Tenant and connection scoped. Provider credentials stay in the caller; these are server-only prompts, never browser data.",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Up to four pending bounded model requests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "requests": {
                      "type": "array",
                      "maxItems": 4,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "system",
                          "user",
                          "maxOutputTokens"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "system": {
                            "type": "string"
                          },
                          "user": {
                            "type": "string"
                          },
                          "maxOutputTokens": {
                            "const": 8192
                          }
                        },
                        "description": "Combined UTF-8 system/user text is at most 65536 bytes. Engine-owned prompt; contains source snippets. No provider key."
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/jobs/{jobId}/model-requests/{requestId}": {
      "post": {
        "operationId": "resolveModelRequest",
        "description": "Requires engine:run on the linked job. Returns accepted:true. Identical redelivery is idempotent; changed results conflict. A new result is rejected after cancellation. The host must not repeat inference after an unknown outcome.",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "text"
                    ],
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "description": "At most 131072 UTF-8 bytes"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "failed"
                    ],
                    "properties": {
                      "failed": {
                        "const": true
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result accepted or identically replayed"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serverToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Random server-side credential; never a browser or GitHub token."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "CreateJob": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connectionId",
          "operation",
          "ref",
          "scanRoots"
        ],
        "properties": {
          "connectionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "operation": {
            "enum": [
              "extract",
              "transform-preview",
              "tune",
              "tune-llm"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "scanRoots": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "description": "Literal repository-relative source paths, each containing supported files. No globs, absolute paths, or traversal."
          },
          "sourceLocale": {
            "type": "string",
            "default": "en-US",
            "description": "Canonicalizable BCP 47 language tag."
          },
          "settings": {
            "$ref": "#/components/schemas/ExtractionSettings"
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "status",
          "operation",
          "connectionId",
          "phase"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "connectionId": {
            "type": "string"
          },
          "operation": {
            "enum": [
              "extract",
              "transform-preview",
              "tune",
              "tune-llm"
            ]
          },
          "ref": {
            "type": "string"
          },
          "scanRoots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceLocale": {
            "type": "string"
          },
          "commitSha": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "phase": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "artifactAvailable": {
            "type": "boolean"
          },
          "error": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "settings": {
            "$ref": "#/components/schemas/ExtractionSettings"
          }
        }
      },
      "Artifact": {
        "type": "object",
        "required": [
          "version",
          "engine",
          "catalog",
          "diagnostics",
          "metrics",
          "coverage",
          "provenance"
        ],
        "properties": {
          "version": {
            "const": 1
          },
          "engine": {
            "type": "object"
          },
          "catalog": {
            "type": "object",
            "description": "Existing private engine's versioned source catalog (schemaVersion, sourceLocale, entries)."
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "metrics": {
            "type": "object"
          },
          "coverage": {
            "type": "object"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "repositoryId": {
                "type": "integer"
              },
              "commitSha": {
                "type": "string"
              },
              "sourceBytes": {
                "type": "integer"
              },
              "operation": {
                "type": "string"
              }
            }
          },
          "preview": {
            "type": "object",
            "description": "Only for transform-preview. Rewritten file contents, original hashes, required runtime modules, and extraction-only file list. No writes applied."
          },
          "tuning": {
            "type": "object",
            "description": "For tune or tune-llm: before/after counts, accepted additive settings, wrote:false and actual llmCalls. LLM mode adds classifiedCount, maximumItems:80 and coverage:bounded. Deterministic mode uses two rounds; LLM mode one round and at most four requests including retries. Both remain within the five-minute processing limit."
          }
        }
      },
      "ExtractionSettings": {
        "type": "object",
        "additionalProperties": false,
        "description": "At most 8 KiB of supported data-only extraction arrays. Defaults remain in effect. No provider settings, commands, plugins or source-scope changes.",
        "properties": {
          "excludePatterns": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "excludeCallees": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "excludeFields": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "denyProps": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "ignoredGlobs": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "fixtureGlobs": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "identifierAllowlist": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "keyShapes": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Structured API error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
